   "source": [
    "def read_grid(filename):\n",
    "    with open(filename) as file:\n",
    "        rows,cols=map(int,file.readline().strip().split(','))\n",
    "        print(\"Rows:\",rows,\"Cols:\",cols)"
   ]
  },
